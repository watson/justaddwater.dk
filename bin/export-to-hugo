#!/usr/bin/env python3 -I
"""Convert the sanitized WordPress export into Hugo content (stdlib + pandoc).

Usage: bin/export-to-hugo [--limit N] [--only SLUG]

Reads:   export/justaddwater.sanitized.xml (make it with bin/sanitize-export)
Writes:  content/posts/<date>-<slug>.md, content/pages/<slug>.md,
         data/comments/<slug>.json   (comments, with parent ids)
Permalinks are preserved through each file's `url` front-matter field.

Options:
  --limit N     convert only the first N items (quick test)
  --only SLUG   convert a single post/page by slug
  -h, --help    show this help

Notes:
  * Takes about 6-7 minutes for everything (one pandoc call per item and
    comment); run it in the background or a spare terminal.
  * It overwrites generated files but deletes nothing. Hand-written files such
    as content/all-posts.md and content/archives/ are left alone, but if you
    `rm -rf content data` first, restore them from git.
  * Needs pandoc on PATH (brew install pandoc).

Example:
  bin/export-to-hugo --only ticket-systems && bin/dev status
"""
import json, os, re, subprocess, sys
import xml.etree.ElementTree as ET
from html import unescape
from urllib.parse import unquote, urlparse

if {"-h", "--help"} & set(sys.argv[1:]):
    print(__doc__.strip())
    sys.exit(0)

os.chdir(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
SRC = "export/justaddwater.sanitized.xml"
W = "{http://wordpress.org/export/1.2/}"; C = "{http://purl.org/rss/1.0/modules/content/}"
BLOCK = r"(?:table|thead|tbody|tfoot|tr|td|th|div|dl|dt|dd|ul|ol|li|pre|form|blockquote|h[1-6]|hr|p|figure|object|embed|script|style|iframe)"
ONLY = sys.argv[sys.argv.index("--only") + 1] if "--only" in sys.argv else None
LIMIT = int(sys.argv[sys.argv.index("--limit") + 1]) if "--limit" in sys.argv else None

def shortcodes(t):
    t = re.sub(r"\[tags[^\]]*\].*?\[/?tags\]", "", t, flags=re.S)
    def code(m):
        body = m.group(2).strip("\n").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
        return '<pre><code%s>%s</code></pre>' % (' class="language-%s"' % m.group(1) if m.group(1) else "", body)
    t = re.sub(r"\[code(?:\s+lang(?:uage)?=\"?(\w+)\"?)?\](.*?)\[/code\]", code, t, flags=re.S)
    t = re.sub(r'\[caption[^\]]*?caption="([^"]*)"[^\]]*\](.*?)\[/caption\]',
               lambda m: "<p>%s</p>\n\n<p><em>%s</em></p>" % (m.group(2).strip(), m.group(1)), t, flags=re.S)
    t = re.sub(r"\[/?caption[^\]]*\]", "", t)
    # embeds pandoc would drop: gist scripts and iframes become plain links
    t = re.sub(r'<script[^>]*src="https?://gist\.github\.com/(\w+)\.js"[^>]*>\s*</script>',
               r'<p><a href="https://gist.github.com/\1">View gist \1 on GitHub</a></p>', t, flags=re.I)
    t = re.sub(r'<iframe[^>]*src="([^"]+)"[^>]*>.*?</iframe>',
               r'<p><a href="\1">Embedded content: \1</a></p>', t, flags=re.I | re.S)
    return t

CONTAINER = r"(?:table|dl|ul|ol|pre|form|blockquote|div|figure|object|script|style|iframe|p|h[1-6])"
TAG = re.compile(r"<(/?)(%s)\b[^>]*?(/?)>" % CONTAINER, re.I)
RECURSE = ("blockquote", "div")

def autop_text(t):
    out = []
    for para in re.split(r"\n\s*\n", t):
        para = para.strip()
        if not para: continue
        if re.match(r"</?%s[\s>/]" % BLOCK, para, re.I):
            out.append(para)
        else:
            out.append("<p>%s</p>" % re.sub(r"[ \t]*\n[ \t]*", "<br>\n", para))
    return out

def next_opener(t, pos):
    for m in TAG.finditer(t, pos):
        if not m.group(1) and not m.group(3): return m

def wpautop(t):
    """Minimal WordPress autop: text outside block containers becomes <p> (blank-line separated,
    single newlines -> <br>); block containers (lists, tables, pre...) are kept verbatim so no
    stray <br> is injected next to or inside them. blockquote/div are processed recursively."""
    t = t.replace("\r\n", "\n").strip()
    out, pos = [], 0
    while True:
        m = next_opener(t, pos)
        if not m:
            out += autop_text(t[pos:]); break
        out += autop_text(t[pos:m.start()])
        name = m.group(2).lower(); depth = 1; end = None
        for mm in TAG.finditer(t, m.end()):
            if mm.group(2).lower() != name or mm.group(3): continue
            depth += -1 if mm.group(1) else 1
            if depth == 0: end = mm; break
        if end is None:
            out.append(t[m.start():]); break
        if name in RECURSE:
            out.append(t[m.start():m.end()] + "\n\n" + wpautop(t[m.end():end.start()]) + "\n\n" + t[end.start():end.end()])
        else:
            out.append(t[m.start():end.end()])
        pos = end.end()
    return "\n\n".join(o for o in out if o)

def to_md(html):
    html = wpautop(shortcodes(html))
    html = re.sub(r'(href|src)="https?://(?:www\.)?justaddwater\.dk(/[^"]*)"', r'\1="\2"', html)
    # explicit <br> hugging block boundaries only produces stray `\\` after conversion
    html = re.sub(r"(?:<br\s*/?>(?:\s|&nbsp;|\xa0)*)+(?=</(?:li|p|td|th|ul|ol|div|blockquote)>|<(?:ul|ol|blockquote|table|p|div)[\s>])", "", html, flags=re.I)
    html = re.sub(r"(<(?:li|ul|ol|td|th)(?:\s[^>]*)?>)\s*(?:<br\s*/?>\s*)+", r"\1", html, flags=re.I)
    r = subprocess.run(["pandoc", "-f", "html", "-t", "gfm-raw_html", "--wrap=none"],
                       input=html, capture_output=True, text=True)
    md = r.stdout if r.returncode == 0 else html
    md = re.sub(r"(?m)^\\[ \t]*$\n?", "", md)      # lone hard breaks beside block elements
    md = re.sub(r"\\\n(?=\n)", "\n", md)          # hard break at paragraph end
    return md.strip()

def fm(d): return "---\n" + "\n".join("%s: %s" % (k, json.dumps(v, ensure_ascii=False)) for k, v in d.items()) + "\n---\n\n"

def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True); open(path, "w", encoding="utf8").write(text)

chan = ET.parse(SRC).getroot().find("channel")
n = 0; ncom = 0; stats = {"post": 0, "page": 0}
for it in chan.findall("item"):
    ptype = it.findtext(W + "post_type")
    if ptype not in ("post", "page"): continue
    if LIMIT and n >= LIMIT: break
    if ONLY and it.findtext(W + "post_name") != ONLY: continue
    slug = unquote(it.findtext(W + "post_name") or "") or "post-%s" % it.findtext(W + "post_id")
    date = (it.findtext(W + "post_date") or "")
    path = unquote(urlparse(it.findtext("link") or "").path) or "/%s/" % slug
    cats = [c.text for c in it.findall("category") if c.get("domain") == "category"]
    tags = [c.text for c in it.findall("category") if c.get("domain") == "post_tag"]
    meta = {"title": " ".join(unescape(it.findtext("title") or slug).split()), "date": date.replace(" ", "T"),
            "slug": slug, "url": path, "wp_id": int(it.findtext(W + "post_id")),
            "categories": cats, "tags": tags}
    body = to_md(it.findtext(C + "encoded") or "")
    base = "content/posts/%s-%s.md" % (date[:10], slug) if ptype == "post" else "content/pages/%s.md" % slug
    write(base, fm(meta) + body + "\n"); stats[ptype] += 1; n += 1
    coms = []
    for c in it.findall(W + "comment"):
        coms.append({"id": int(c.findtext(W + "comment_id")), "parent": int(c.findtext(W + "comment_parent") or 0),
                     "author": unescape(c.findtext(W + "comment_author") or ""), "url": unescape(c.findtext(W + "comment_author_url") or ""),
                     "date": c.findtext(W + "comment_date"), "type": c.findtext(W + "comment_type") or "",
                     "html": to_md(c.findtext(W + "comment_content") or "")})
    if coms: write("data/comments/%s.json" % slug, json.dumps(coms, ensure_ascii=False, indent=1)); ncom += len(coms)
print("posts %d, pages %d, comments %d" % (stats["post"], stats["page"], ncom))
