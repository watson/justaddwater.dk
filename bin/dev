#!/bin/bash
# Manage the local Hugo dev server.
#
#   bin/dev [start]   start the server in the background (default)
#   bin/dev stop      stop the server
#   bin/dev restart   stop, rebuild with `hugo --gc --quiet`, then start
#   bin/dev status    show whether the server is running
#
# PORT overrides the port (default 1313). Non-default ports use their own
# pid/log files: logs/hugo-server-<PORT>.{pid,log}.
set -euo pipefail

cd "$(dirname "$0")/.."

PORT="${PORT:-1313}"
if [ "$PORT" = "1313" ]; then
  PID_FILE="logs/hugo-server.pid"
  LOG_FILE="logs/hugo-server.log"
else
  PID_FILE="logs/hugo-server-$PORT.pid"
  LOG_FILE="logs/hugo-server-$PORT.log"
fi
URL="http://localhost:$PORT/"

help_text() {
  cat <<EOT
bin/dev - run the Hugo dev server for this site (live-reloads content, layouts, assets)

Usage: bin/dev [start|stop|restart|status|help]

Commands:
  start    start the server in the background on port $PORT, wait until it
           answers, print the URL (default; does nothing if already running)
  stop     stop the server (uses the pid file, else whatever listens on $PORT)
  restart  stop, rebuild the site with 'hugo --gc --quiet' (a broken template
           or hugo.toml aborts here with the real error), then start again.
           Needed after hugo.toml or new layouts/ directories change.
  status   show whether the server is up (exit 0 = up, 1 = down)
  help     show this help (also -h, --help)

Environment:
  PORT=<n>   use another port (default 1313); pid/log files are per port

Files: logs/hugo-server.pid, logs/hugo-server.log
Example: PORT=1399 bin/dev start
EOT
}

usage() {
  help_text >&2
}

# PIDs of processes listening on $PORT (newline separated, may be empty).
listening_pids() {
  lsof -ti "tcp:$PORT" -sTCP:LISTEN 2>/dev/null || true
}

# HTTP status code for $URL, or 000 if nothing answers.
http_code() {
  curl -s -o /dev/null -w '%{http_code}' --max-time 2 "$URL" 2>/dev/null || true
}

# Pid recorded in PID_FILE if that process is alive, else empty.
recorded_pid() {
  local pid=""
  if [ -f "$PID_FILE" ]; then
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "$pid"
      return 0
    fi
  fi
  return 0
}

cmd_start() {
  local pids
  pids="$(listening_pids)"
  if [ -n "$pids" ]; then
    echo "Hugo server already running on port $PORT (pid $(echo $pids)): $URL"
    exit 0
  fi

  local old
  old="$(recorded_pid)"
  if [ -n "$old" ]; then
    echo "Hugo server (pid $old) is starting but not listening yet on port $PORT; not starting another." >&2
    exit 1
  fi
  rm -f "$PID_FILE"

  mkdir -p logs
  echo "Starting Hugo server on port $PORT (log: $LOG_FILE)..."
  nohup hugo server --port "$PORT" --disableFastRender >>"$LOG_FILE" 2>&1 &
  local pid=$!
  echo "$pid" > "$PID_FILE"

  local i=0
  while [ "$i" -lt 20 ]; do
    if [ "$(http_code)" = "200" ]; then
      echo "Hugo server running (pid $pid): $URL"
      exit 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "Hugo server exited during startup. Last log lines:" >&2
      tail -n 20 "$LOG_FILE" >&2 || true
      rm -f "$PID_FILE"
      exit 1
    fi
    sleep 0.5
    i=$((i + 1))
  done

  echo "Hugo server did not answer 200 at $URL within 10s (pid $pid still alive). See $LOG_FILE" >&2
  exit 1
}

# Stop the server on $PORT. Returns 0 if the port is free afterwards, 1 otherwise.
stop_server() {
  local pid
  pid="$(recorded_pid)"
  local targets=""
  if [ -n "$pid" ]; then
    targets="$pid"
  else
    targets="$(listening_pids)"
  fi

  if [ -z "$targets" ]; then
    rm -f "$PID_FILE"
    echo "No Hugo server running on port $PORT; nothing to stop."
    return 0
  fi

  local p
  for p in $targets; do
    kill "$p" 2>/dev/null || true
  done

  local i=0
  while [ "$i" -lt 10 ]; do
    if [ -z "$(listening_pids)" ]; then
      break
    fi
    sleep 0.5
    i=$((i + 1))
  done

  for p in $targets; do
    if kill -0 "$p" 2>/dev/null; then
      kill -9 "$p" 2>/dev/null || true
    fi
  done

  rm -f "$PID_FILE"
  if [ -z "$(listening_pids)" ]; then
    echo "Stopped Hugo server on port $PORT (pid $(echo $targets))."
    return 0
  fi
  echo "Sent kill to Hugo server on port $PORT (pid $(echo $targets)), but port $PORT is still in use." >&2
  return 1
}

cmd_stop() {
  stop_server || true
  exit 0
}

cmd_restart() {
  echo "Restarting Hugo server on port $PORT..."
  if ! stop_server; then
    echo "Restart aborted: port $PORT is still in use after stop. Free it, then run: $(restart_hint)" >&2
    exit 1
  fi

  echo "Building site: hugo --gc --quiet"
  if ! hugo --gc --quiet; then
    # --quiet hides error details, so re-run without it to show the cause.
    hugo --gc >&2 || true
    echo "Restart aborted: hugo build failed (see error above). Server on port $PORT is stopped." >&2
    echo "Fix the error, then run: $(restart_hint)" >&2
    exit 1
  fi
  echo "Build succeeded."

  cmd_start
}

# Copy-pasteable command to re-run restart on the current PORT.
restart_hint() {
  if [ "$PORT" = "1313" ]; then
    echo "bin/dev restart"
  else
    echo "PORT=$PORT bin/dev restart"
  fi
}

cmd_status() {
  local pids code pid
  pids="$(listening_pids)"
  pid="$(recorded_pid)"
  code="$(http_code)"

  if [ -n "$pids" ]; then
    echo "Hugo server running on port $PORT (listening pid $(echo $pids)); HTTP $code at $URL"
  else
    echo "No Hugo server listening on port $PORT."
  fi
  if [ -n "$pid" ]; then
    echo "PID file: $PID_FILE (pid $pid, alive)"
  elif [ -f "$PID_FILE" ]; then
    echo "PID file: $PID_FILE (stale)"
  else
    echo "PID file: none ($PID_FILE)"
  fi
  if [ -n "$pids" ]; then
    exit 0
  fi
  exit 1
}

case "${1:-start}" in
  start)  cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  help|-h|--help) help_text ;;
  *)      usage; exit 2 ;;
esac
