#!/usr/bin/env bash
# Mirror justaddwater.dk into ./mirror (frozen safety copy). Re-runnable.
# Usage: bin/mirror [-h|--help] [base-url]
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  cat <<EOT
bin/mirror - wget mirror of the live site into ./mirror (frozen safety copy)

Usage: bin/mirror [-h|--help] [BASE_URL]

  BASE_URL    site to mirror (default http://justaddwater.dk/)

Downloads pages, images, CSS and JS from justaddwater.dk and www.justaddwater.dk
only, rewrites links for local browsing, skips wp-admin, login, search and
reply links, and waits ~0.3 s between requests (the old PHP 5.2 server is slow).
Re-runnable; unchanged files are skipped. Takes a while for the whole site.

Output: mirror/ (git-ignored), log in logs/mirror-YYYYMMDD.log
Exit:   wget code 8 (some 404s) is normal and does not fail the script.
Next:   bin/scan (check uploads for suspicious files), bin/copy-uploads
EOT
  exit 0
fi

URL="${1:-http://justaddwater.dk/}"
OUT="mirror"
command -v wget >/dev/null || { echo "wget missing: brew install wget" >&2; exit 1; }

mkdir -p "$OUT" logs
wget \
  --mirror \
  --page-requisites \
  --adjust-extension \
  --convert-links \
  --no-parent \
  --domains justaddwater.dk,www.justaddwater.dk \
  --reject-regex '(wp-login|wp-admin|xmlrpc|\?replytocom=|/feed/.+|\?s=)' \
  --wait 0.3 --random-wait \
  --tries 3 --timeout 30 \
  --user-agent "justaddwater-archive/1.0 (owner mirror)" \
  --directory-prefix "$OUT" \
  --append-output "logs/mirror-$(date +%Y%m%d).log" \
  "$URL" || echo "wget exited $? (code 8 = some 404s, usually fine)"

echo "Files:  $(find "$OUT" -type f | wc -l | tr -d ' ')"
echo "Size:   $(du -sh "$OUT" | cut -f1)"
echo "Posts:  $(find "$OUT" -name '*.html' | wc -l | tr -d ' ') html pages"
echo "Log:    logs/mirror-$(date +%Y%m%d).log"
