#!/usr/bin/env python3 -I
"""Extract the hand-written WordPress excerpts into data/excerpts.json.

Usage: bin/export-excerpts [RAW_XML]   (default export/raw-justaddwater.xml)

The sanitized export drops <excerpt:encoded>, so this reads the raw one.
Output maps post slug -> excerpt HTML (paragraphs wrapped like wpautop).
Only posts with a non-empty excerpt appear; templates fall back to the
first 55 words (as WordPress does) for the rest.
"""
import json, os, re, sys
if {"-h", "--help"} & set(sys.argv[1:]):
    print(__doc__.strip()); sys.exit(0)
os.chdir(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
src = sys.argv[1] if len(sys.argv) > 1 else "export/raw-justaddwater.xml"
s = open(src, encoding="utf8").read()
out = {}
for it in s.split("<item>")[1:]:
    t = re.search(r"<wp:post_type>(?:<!\[CDATA\[)?(\w+)", it)
    if not t or t.group(1) != "post":
        continue
    e = re.search(r"<excerpt:encoded>(.*?)</excerpt:encoded>", it, re.S)
    n = re.search(r"<wp:post_name>(?:<!\[CDATA\[)?([^\]<]*)", it)
    if not e or not n:
        continue
    txt = re.sub(r"<!\[CDATA\[|\]\]>", "", e.group(1)).strip()
    if not txt:
        continue
    txt = txt.replace("http://justaddwater.dk/wp-content", "/wp-content")
    paras = [p.strip() for p in re.split(r"\n\s*\n", txt) if p.strip()]
    out[n.group(1)] = "\n".join(p if p.startswith("<p") else "<p>%s</p>" % p.replace("\n", "<br />\n") for p in paras)
os.makedirs("data", exist_ok=True)
json.dump(out, open("data/excerpts.json", "w", encoding="utf8"), ensure_ascii=False, indent=1, sort_keys=True)
print("wrote data/excerpts.json: %d excerpts" % len(out))
