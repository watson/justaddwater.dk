#!/usr/bin/env bash
# Build the pixelpilot review (original vs new site) and open it from disk.
# Usage: bin/compare [--shoot] [--no-open]
#   --shoot    retake all screenshots first (bin/screenshot --all)
#   --no-open  only build the page
# Baseline = screenshots/orig as committed at tag orig-screenshots-v2
# (pixelpilot reads the baseline from git; override with BASELINE_REF=<ref>).
set -euo pipefail
cd "$(dirname "$0")/.."

usage() {
  cat <<EOT
bin/compare - build the pixelpilot review (original vs new site) and open it from disk

Usage: bin/compare [--shoot] [--no-open] [-h|--help]

  --shoot     retake all screenshots first (bin/screenshot --all, ~25 s)
  --no-open   only build the page, do not open the browser
  -h, --help  show this help

Compares screenshots/dev (current, the new Hugo site) against screenshots/orig
(baseline, the original WordPress site) as committed at git tag
orig-screenshots-v2. Writes tmp/screenshot-review/index.html and opens
it with 'open' (no server needed).

Environment:
  BASELINE_REF=<ref>   git ref to read the baseline PNGs from
  PIXELPILOT=<path>    pixelpilot executable (default ~/src/dotfiles/bin/pixelpilot)
EOT
}

shoot=0; open_page=1
for a in "$@"; do
  case "$a" in
    --shoot) shoot=1 ;;
    --no-open) open_page=0 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

[ "$shoot" = 1 ] && bin/screenshot --all

ref="${BASELINE_REF:-orig-screenshots-v2}"
if ! git merge-base --is-ancestor "$ref" HEAD 2>/dev/null; then
  cat >&2 <<EOT
Baseline '$ref' is missing or not reachable from HEAD (was history rewritten?).
pixelpilot needs a tag reachable from HEAD. Find the commit that holds the
original screenshots and re-point the tag at it:
  git log --oneline -- screenshots/orig | head -3
  git tag -f $ref <commit>
EOT
  exit 1
fi

out=tmp/screenshot-review
rm -rf "$out"
"${PIXELPILOT:-$HOME/src/dotfiles/bin/pixelpilot}" \
  --baseline "$ref" \
  --screenshots-dir screenshots/orig \
  --current-dir screenshots/dev \
  --baseline-dir "$out/baseline" \
  --output-html "$out/index.html" \
  --title "justaddwater.dk: original (baseline) vs new Hugo (current)" >/dev/null

echo "Review page: $PWD/$out/index.html"
[ "$open_page" = 1 ] && open "$out/index.html"
exit 0
