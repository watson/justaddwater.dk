#!/usr/bin/env bash
# Compare the original WordPress site with the new Hugo site, from the screenshot folders.
# Usage: bin/compare [--shoot] [--no-open] [--report] [--fail-above PCT] [--only a,b]
set -euo pipefail
cd "$(dirname "$0")/.."

usage() {
  cat <<EOT
bin/compare - compare screenshots/orig (original WordPress) with screenshots/dev (new Hugo) in pixelpilot

Usage: bin/compare [--shoot] [--no-open] [--report] [--fail-above PCT] [--only a,b] [-h|--help]

  --shoot            retake all screenshots first (bin/screenshot --all, ~25 s)
  --no-open          build the review page but do not open the browser
  --report           print a numeric table instead (per page: sizes, height delta,
                     % differing pixels, first differing row, per-100px bands)
  --fail-above PCT   with --report: exit 1 if any page differs by more than PCT %
  --only a,b         with --report: only these pages (number or file-name prefix)
  -h, --help         show this help

Default: builds tmp/screenshot-review/index.html and opens it from disk (no server).
Both sides are plain folders read in place (no git tags needed): the baseline is
screenshots/orig, the current side is screenshots/dev.

Environment:
  PIXELPILOT=<path>   pixelpilot executable (default ~/src/dotfiles/bin/pixelpilot)
EOT
}

shoot=0; open_page=1; report=0; fail_above=""; only=""
while [ $# -gt 0 ]; do
  case "$1" in
    --shoot) shoot=1 ;;
    --no-open) open_page=0 ;;
    --report) report=1 ;;
    --fail-above) fail_above="${2:?--fail-above needs a percentage}"; shift ;;
    --only) only="${2:?--only needs a list}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

[ "$shoot" = 1 ] && bin/screenshot --all

pp="${PIXELPILOT:-$HOME/src/dotfiles/bin/pixelpilot}"
args=(--baseline-folder screenshots/orig --current-dir screenshots/dev
      --baseline-label "WordPress (original)" --current-label "Hugo (new)")

if [ "$report" = 1 ]; then
  [ -n "$fail_above" ] && args+=(--fail-above "$fail_above")
  [ -n "$only" ] && args+=(--only "$only")
  exec "$pp" "${args[@]}" --report
fi

out=tmp/screenshot-review
rm -rf "$out"
"$pp" "${args[@]}" --baseline-dir "$out/baseline" --output-html "$out/index.html" \
  --title "justaddwater.dk: WordPress (original) vs Hugo (new)" >/dev/null

echo "Review page: $PWD/$out/index.html"
[ "$open_page" = 1 ] && open "$out/index.html"
exit 0
