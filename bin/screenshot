#!/usr/bin/env node
// bin/screenshot - full-page screenshots for visually comparing new vs original site.
//
// Usage:
//   bin/screenshot --dev              http://localhost:1313      -> screenshots/dev/
//   bin/screenshot --orig             http://justaddwater.dk     -> screenshots/orig/
//   bin/screenshot --dev --host URL   override host (output dir still screenshots/dev)
//   bin/screenshot --orig --pages FILE   use another page list
//   bin/screenshot --dev --only 05,07    only these numbers (or slug substrings)
//
// Pages: bin/screenshot-pages.txt (one path per line, "# comment", optional
// "dev=/x/ orig=/y/" overrides). Same list for both hosts => identical file
// names (NN-slug.png). Plain http is fine; HTTPS errors are ignored.
// Setup once: yarn install && npx playwright install chromium
const fs = require('fs'), path = require('path');
const root = path.resolve(__dirname, '..');
const { chromium } = require(path.join(root, 'node_modules', 'playwright'));

const args = process.argv.slice(2);
const opt = (n) => { const i = args.indexOf(n); return i >= 0 ? args[i + 1] : null; };
const mode = args.includes('--orig') ? 'orig' : args.includes('--dev') ? 'dev' : null;
if (!mode) { console.error('usage: bin/screenshot --dev|--orig [--host URL] [--pages FILE] [--only a,b]'); process.exit(2); }
const host = (opt('--host') || (mode === 'dev' ? 'http://localhost:1313' : 'http://justaddwater.dk')).replace(/\/$/, '');
const pagesFile = opt('--pages') || path.join(__dirname, 'screenshot-pages.txt');
const only = (opt('--only') || '').split(',').filter(Boolean);
const outDir = path.join(root, 'screenshots', mode);
fs.mkdirSync(outDir, { recursive: true });

const pages = fs.readFileSync(pagesFile, 'utf8').split('\n').map(l => l.replace(/\s#.*$/, '').trim())
  .filter(l => l && !l.startsWith('#')).map((l, i) => {
    const [p, ...rest] = l.split(/\s+/);
    const ov = Object.fromEntries(rest.map(r => r.split('=')));
    const slug = (p === '/' ? 'home' : p.replace(/^\/|\/$/g, '').split('/').pop()).slice(0, 40);
    return { n: String(i + 1).padStart(2, '0'), path: ov[mode] || p, slug };
  });

const sleep = (ms) => new Promise(r => setTimeout(r, ms));
(async () => {
  const browser = await chromium.launch();
  const ctx = await browser.newContext({ viewport: { width: 1200, height: 900 }, ignoreHTTPSErrors: true });
  const page = await ctx.newPage();
  const ok = [], failed = [];
  for (const p of pages) {
    if (only.length && !only.some(o => o === p.n || p.slug.includes(o))) continue;
    const file = `${p.n}-${p.slug}.png`, url = host + p.path;
    try {
      const resp = await page.goto(url, { waitUntil: 'domcontentloaded', timeout: 90000 });
      await page.waitForLoadState('load', { timeout: 30000 }).catch(() => {});
      const status = resp ? resp.status() : 0;
      await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
      // scroll through to trigger lazy images, then wait for all to finish
      await page.evaluate(async () => {
        for (let y = 0; y < document.body.scrollHeight; y += 800) { window.scrollTo(0, y); await new Promise(r => setTimeout(r, 60)); }
        window.scrollTo(0, 0);
        await Promise.all([...document.images].filter(i => !i.complete).map(i => new Promise(r => { i.onload = i.onerror = r; setTimeout(r, 8000); })));
      });
      await page.screenshot({ path: path.join(outDir, file), fullPage: true });
      (status >= 400 ? failed : ok).push(`${file} ${url} HTTP ${status}`);
      console.log(`${status >= 400 ? 'BAD ' : 'ok  '} ${file} (HTTP ${status})`);
    } catch (e) {
      failed.push(`${file} ${url} ${e.message.split('\n')[0]}`);
      console.log(`FAIL ${file}: ${e.message.split('\n')[0]}`);
    }
    await sleep(mode === 'orig' ? 800 : 100);
  }
  await browser.close();
  console.log(`\nSummary (${mode}, ${host}): ${ok.length} ok, ${failed.length} failed`);
  failed.forEach(f => console.log('  - ' + f));
  process.exit(failed.length ? 1 : 0);
})();
