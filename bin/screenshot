#!/usr/bin/env node
// bin/screenshot - full-page screenshots for visually comparing new vs original site.
//
// Usage: bin/screenshot --all|--dev|--orig [options]   (-h, --help shows this)
//
//   bin/screenshot --all                 dev + orig concurrently (same as --dev --orig)
//   bin/screenshot --dev                 http://localhost:1313   -> screenshots/dev/
//   bin/screenshot --orig                http://justaddwater.dk  -> screenshots/orig/
//   --host URL     override host (only with a single site; output dir unchanged)
//   --pages FILE   use another page list
//   --only 05,07   only these numbers (or slug substrings)
//   --width N      viewport width, default 800 (deviceScaleFactor 1, full page)
//   --jobs N       parallel pages per site (default 4)
//   --wait MS      max wait per page for load, network idle, fonts, images and CSS
//                  background images (default 10000); a slow asset never hangs a run
//
// Pages: bin/screenshot-pages.txt (one path per line, "# comment", optional
// "dev=/x/ orig=/y/" overrides). File number NN is the position among the
// non-comment lines, so append new pages at the end. Same list for both hosts
// => identical names (NN-slug.png). Fast: domcontentloaded + images decoded
// (--wait cap, default 10 s), 20 s navigation timeout, one retry, analytics/ads blocked,
// animations/caret disabled. Search pages (/?s=term) also wait for the redirect and rendered results. Exit code 1 if any page failed.
// Setup once: yarn install && npx playwright install chromium
// Examples:
//   bin/screenshot --all                  retake everything (~25 s)
//   bin/screenshot --dev --only 01,34     two pages on the new site
//   bin/compare                           then review the diffs in pixelpilot
const fs = require('fs'), path = require('path');
const root = path.resolve(__dirname, '..');

if (process.argv.slice(2).some(a => a === '-h' || a === '--help')) {
  const lines = fs.readFileSync(__filename, 'utf8').split('\n').slice(1);
  const out = [];
  for (const l of lines) { if (!l.startsWith('//')) break; out.push(l.replace(/^\/\/ ?/, '')); }
  console.log(out.join('\n'));
  process.exit(0);
}
const { chromium } = require(path.join(root, 'node_modules', 'playwright'));

const args = process.argv.slice(2);
const opt = (n) => { const i = args.indexOf(n); return i >= 0 ? args[i + 1] : null; };
const all = args.includes('--all');
const modes = ['dev', 'orig'].filter(m => all || args.includes('--' + m));
if (!modes.length) { console.error('usage: bin/screenshot --all|--dev|--orig [--host URL] [--pages FILE] [--only a,b] [--width N] [--jobs N] [--wait MS]  (see --help)'); process.exit(2); }
const width = parseInt(opt('--width') || '800', 10);
const waitMs = parseInt(opt('--wait') || '10000', 10);
const pagesFile = opt('--pages') || path.join(__dirname, 'screenshot-pages.txt');
const only = (opt('--only') || '').split(',').filter(Boolean);
const BLOCK = /google-analytics|googletagmanager|doubleclick|googlesyndication|feedburner|measuremap|statcounter|quantserve|scorecardresearch|adsense|pagead|technorati\.com\/.*(badge|counter)/i;
const sleep = (ms) => new Promise(r => setTimeout(r, ms));

function loadPages(mode) {
  return fs.readFileSync(pagesFile, 'utf8').split('\n').map(l => l.replace(/\s#.*$/, '').trim())
    .filter(l => l && !l.startsWith('#')).map((l, i) => {
      const [p, ...rest] = l.split(/\s+/);
      const ov = Object.fromEntries(rest.map(r => r.split('=')));
      const segs = p.replace(/^\/|\/$/g, '').split('/');
      // date archives (/2011/09/) and author archives (/author/x/) need the parent segment to be readable
      const join = segs.length > 1 && (/^\d+$/.test(segs[segs.length - 1]) || segs[0] === 'author');
      const sm = p.match(/[?&]s=([^&]+)/); // WordPress search URL /?s=a+b -> search-a-b
      const slug = sm ? ('search-' + decodeURIComponent(sm[1].replace(/\+/g, ' ')).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')).slice(0, 40) : (p === '/' ? 'home' : (join ? segs.slice(-2).join('-') : segs[segs.length - 1])).slice(0, 40);
      return { n: String(i + 1).padStart(2, '0'), path: ov[mode] || p, slug };
    }).filter(p => !only.length || only.some(o => o === p.n || p.slug.includes(o)));
}

// Waits until the page is really painted: load event, network idle, fonts, every <img> decoded and every
// CSS background image loaded, each capped by --wait (default 10 s) so a dead asset never hangs a run.
async function settle(page, waitMs) {
  await page.waitForLoadState('load', { timeout: waitMs }).catch(() => {});
  await page.waitForLoadState('networkidle', { timeout: waitMs }).catch(() => {});
  await page.evaluate((cap) => {
    const bgUrls = new Set();
    for (const el of document.querySelectorAll('*')) {
      for (const pseudo of [null, '::before', '::after']) {
        const bg = getComputedStyle(el, pseudo).backgroundImage;
        for (const m of bg.matchAll(/url\(["']?([^"')]+)["']?\)/g)) bgUrls.add(m[1]);
      }
    }
    const load = (u) => new Promise(r => { const i = new Image(); i.onload = i.onerror = () => r(); i.src = u; });
    const imgs = [...document.images].map(i => i.complete ? (i.decode ? i.decode().catch(() => {}) : 0)
      : new Promise(r => { i.onload = i.onerror = r; }).then(() => i.decode ? i.decode().catch(() => {}) : 0));
    return Promise.race([
      Promise.all([document.fonts ? document.fonts.ready : 0, ...imgs, ...[...bgUrls].map(load)]),
      new Promise(r => setTimeout(r, cap))]);
  }, waitMs);
  await page.evaluate(() => new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r))));
}

async function shoot(ctx, url, out) {
  const page = await ctx.newPage();
  try {
    const resp = await page.goto(url, { waitUntil: 'domcontentloaded', timeout: 20000 });
    await page.addStyleTag({ content: '*,*::before,*::after{animation:none!important;transition:none!important;caret-color:transparent!important}' }).catch(() => {});
    // search page: dev redirects /?s= with JS and renders results asynchronously; wait for them
    if (/[?&]s=/.test(url) && new URL(url).host === 'localhost:1313') await page.waitForURL(/\/search\//, { timeout: waitMs }).catch(() => {});
    if (page.url().includes('/search/')) await page.waitForSelector('#sp-results[data-ready="1"]', { timeout: waitMs }).catch(() => {});
    await settle(page, waitMs);
    await page.screenshot({ path: out, fullPage: true, animations: 'disabled', caret: 'hide', timeout: 20000 });
    return resp ? resp.status() : 0;
  } finally { await page.close().catch(() => {}); }
}

async function runSite(mode) {
  const host = ((modes.length === 1 && opt('--host')) || (mode === 'dev' ? 'http://localhost:1313' : 'http://justaddwater.dk')).replace(/\/$/, '');
  const jobs = parseInt(opt('--jobs') || (mode === 'dev' ? '4' : '4'), 10);
  const outDir = path.join(root, 'screenshots', mode);
  fs.mkdirSync(outDir, { recursive: true });
  const queue = loadPages(mode), ok = [], failed = [];
  const browser = await chromium.launch();
  const ctx = await browser.newContext({ viewport: { width, height: 900 }, deviceScaleFactor: 1, ignoreHTTPSErrors: true, reducedMotion: 'reduce' });
  await ctx.route('**/*', r => { const u = new URL(r.request().url()); return u.host !== new URL(host).host && BLOCK.test(u.host + u.pathname) ? r.abort() : r.continue(); });
  const worker = async (w) => {
    if (mode === 'orig') await sleep(w * 150);
    for (let p; (p = queue.shift());) {
      const file = `${p.n}-${p.slug}.png`, url = host + p.path;
      let err = null, status = 0;
      for (let a = 0; a < 2; a++) {
        try { status = await shoot(ctx, url, path.join(outDir, file)); err = null; if (status < 500) break; err = `HTTP ${status}`; }
        catch (e) { err = e.message.split('\n')[0]; }
      }
      if (err || status >= 400) { failed.push(`${file} ${url} ${err || 'HTTP ' + status}`); console.log(`FAIL ${mode} ${file}: ${err || 'HTTP ' + status}`); }
      else { ok.push(file); console.log(`ok   ${mode} ${file}`); }
    }
  };
  await Promise.all(Array.from({ length: jobs }, (_, w) => worker(w)));
  await browser.close();
  return { mode, host, ok, failed };
}

(async () => {
  const t0 = Date.now();
  const results = await Promise.all(modes.map(runSite));
  console.log('');
  let bad = 0;
  for (const r of results) {
    console.log(`Summary ${r.mode} (${r.host}, width ${width}): ${r.ok.length} ok, ${r.failed.length} failed`);
    r.failed.forEach(f => console.log('  - ' + f));
    bad += r.failed.length;
  }
  console.log(`Wall-clock: ${((Date.now() - t0) / 1000).toFixed(1)}s`);
  process.exit(bad ? 1 : 0);
})();
